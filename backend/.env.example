# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/smart_doctor_connect
# For SQLite (development):
# DATABASE_URL=sqlite:///./smart_doctor_connect.db

# Server Configuration
DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Smart Doctor Connect AI
PROJECT_VERSION=1.0.0

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Email Configuration (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# AI/ML Configuration
AI_MODEL_PATH=/models/doctor_recommendation_model
AI_ENABLED=True

# Payment Configuration
STRIPE_API_KEY=sk_test_your_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
